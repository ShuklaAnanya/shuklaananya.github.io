<section class="section" id="talks" aria-labelledby="talks-title">
  <header class="section-heading">
    <p class="eyebrow">Sharing research</p>
    <h2 id="talks-title">Talks &amp; Presentations</h2>
  </header>
  {% for talk in site.data.academic.talks %}
    <article class="talk icon-entry">
      <span class="entry-icon">{% include research/icon.liquid name='presentation' %}</span>
      <div>
        <h3>{{ talk.title }}</h3>
        <p class="talk-date">
          <time datetime="{{ talk.datetime }}">
            {{- talk.date }}
            <span class="separator"> · </span> {{ talk.time -}}
          </time>
        </p>
        <p class="talk-venue">
          {{ talk.venue }}
          <span class="separator"> · </span> {{ talk.session }} - {{ talk.topic }}
        </p>
        <p class="talk-location">
          {% if talk.poster_url %}
            <a href="{{ talk.poster_url | relative_url }}">
              {%- include research/icon.liquid name='presentation' %}
              {{ talk.poster -}}
            </a>
          {% else %}
            {{ talk.poster }}
          {% endif %}
          <span class="separator"> · </span> {{ talk.location }}
        </p>
      </div>
    </article>
  {% endfor %}
</section>
