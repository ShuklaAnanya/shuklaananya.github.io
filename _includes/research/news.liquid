<section class="news-section" id="news" aria-labelledby="news-title">
  <h2 class="eyebrow" id="news-title">News</h2>
  {% assign news_items = site.data.news | sort: 'date' | reverse %}
  <ol class="news-list">
    {% for item in news_items limit: 4 -%}
      {%- include research/news-row.liquid item=item -%}
    {%- endfor %}
  </ol>
  {% if news_items.size > 4 %}
    <details
      class="news-archive"
      {% if include.expanded %}
        open
      {% endif %}
    >
      <summary>
        <span class="show-more"
          >Show all news <span class="count">({{ news_items.size }})</span></span
        ><span class="show-less">Show less</span>{% include research/icon.liquid name='chevron' %}
      </summary>
      <ol class="news-list" start="5">
        {% for item in news_items offset: 4 -%}
          {%- include research/news-row.liquid item=item -%}
        {%- endfor %}
      </ol>
    </details>
  {% endif %}
</section>
