<header class="site-header">
  <div class="reading-progress" aria-hidden="true"><span></span></div>
  <nav class="container navigation" aria-label="Main navigation">
    <div class="navigation-actions">
      <button
        class="menu-toggle icon-button"
        type="button"
        aria-label="Open navigation"
        aria-expanded="false"
        aria-controls="navigation-links"
        hidden
      >
        {% include research/icon.liquid name='menu' %}
      </button>
      <button class="theme-toggle icon-button" type="button" aria-label="Switch to dark theme" title="Switch to dark theme" hidden>
        <span class="moon">{% include research/icon.liquid name='moon' %}</span>
        <span class="sun">{% include research/icon.liquid name='sun' %}</span>
      </button>
    </div>
    <ul id="navigation-links" class="navigation-links">
      {% for item in site.data.navigation %}
        <li>
          <a href="{{ '/' | relative_url }}#{{ item.id }}" data-section="{{ item.id }}">{{ item.label }}</a>
        </li>
      {% endfor %}
    </ul>
  </nav>
</header>
