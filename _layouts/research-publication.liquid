---
---
<article class="publication" aria-labelledby="paper-{{ entry.key }}">
  {% if page.permalink == '/publications/' %}
    <h2 id="paper-{{ entry.key }}">{{ entry.title }}</h2>
  {% else %}
    <h3 id="paper-{{ entry.key }}">{{ entry.title }}</h3>
  {% endif %}
  <p class="authors">
    {% for author in entry.author_array -%}
      {%- if author.first == 'Ananya' and author.last == 'Shukla' -%}
        <strong class="self-author">
          {{- author.first }}
          {{ author.last -}}
        </strong>
      {%- else -%}
        {{- author.first }}
        {{ author.last -}}
      {%- endif -%}
      {%- unless forloop.last %}, {% endunless -%}
    {%- endfor %}
  </p>
  <p class="venue">
    <span>
      {%- if entry.booktitle %}{{ entry.booktitle }}{% else %}{{ entry.journal }}{% endif -%}</span
    ><span class="separator"> · </span>{{ entry.year -}}
    {%- if entry.journal == 'bioRxiv' -%}
      <span class="separator"> · </span><span>Preprint</span>
    {%- endif -%}
    {%- if entry.award_name -%}
      <span class="separator"> · </span><span class="distinction">{{ entry.award_name }}</span>
    {%- endif %}
  </p>
  {% if site.show_publication_topics and entry.topics %}
    <ul class="publication-tags" aria-label="Research topics">
      {% assign topics = entry.topics | split: ';' %}
      {% for topic in topics %}
        <li>{{ topic | strip | escape }}</li>
      {% endfor %}
    </ul>
  {% endif %}
  {% if entry.html or entry.pdf or entry.doi or entry.arxiv or entry.website or entry.code or entry.poster %}
    <div class="paper-links" aria-label="Links for {{ entry.title | escape }}">
      {% if entry.html -%}
        <a href="{{ entry.html }}">{% include research/icon.liquid name='paper' %} Paper</a>
      {%- elsif entry.doi -%}
        <a href="https://doi.org/{{ entry.doi }}">{% include research/icon.liquid name='paper' %} Paper</a>
      {%- elsif entry.arxiv -%}
        <a href="https://arxiv.org/abs/{{ entry.arxiv }}">{% include research/icon.liquid name='paper' %} Paper</a>
      {%- elsif entry.pdf -%}
        <a href="{% if entry.pdf contains '://' %}{{ entry.pdf }}{% else %}{{ entry.pdf | prepend: '/assets/pdf/' | relative_url }}{% endif %}">
          {%- include research/icon.liquid name='paper' %} Paper</a
        >
      {%- endif %}
      {% if entry.website -%}
        <a href="{{ entry.website }}">{% include research/icon.liquid name='globe' %} Project Page</a>
      {%- endif %}
      {% if entry.poster -%}
        <a href="{{ entry.poster | relative_url }}">{% include research/icon.liquid name='presentation' %} Poster</a>
      {%- endif %}
      {% if entry.code -%}
        <a href="{{ entry.code }}">
          {%- include research/icon.liquid name='github' %} GitHub{% if entry.code_private == 'true' %} (private){% endif -%}
        </a>
      {%- endif %}
    </div>
  {% endif %}
</article>
