<!doctype html>
<html lang="{{ site.lang | default: 'en' }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <title>
      {% unless page.permalink == '/' %}{{ page.title | escape }} · {% endunless %}
      {{ site.title | escape }}
    </title>
    <meta name="description" content="{{ site.description | strip | escape }}">
    <meta name="color-scheme" content="light dark">
    <meta name="theme-color" content="#ffffff">
    <link rel="canonical" href="{{ page.url | absolute_url }}">
    <meta property="og:type" content="website">
    <meta property="og:title" content="{{ site.title | escape }}{% unless page.permalink == '/' %} · {{ page.title | escape }}{% endunless %}">
    <meta property="og:description" content="{{ site.description | strip | escape }}">
    <meta property="og:url" content="{{ page.url | absolute_url }}">
    <meta property="og:image" content="{{ site.data.profile.portrait | absolute_url }}">
    <meta property="og:image:alt" content="Ananya Shukla">
    <link rel="icon" href="{{ '/assets/research/favicon.svg' | relative_url }}" type="image/svg+xml">
    <link rel="preload" href="{{ '/assets/research/Inter-latin.woff2' | relative_url }}" as="font" type="font/woff2" crossorigin>
    <script>
      try {
        if (localStorage.getItem('ananya-theme') === 'dark') document.documentElement.dataset.theme = 'dark';
      } catch (e) {}
    </script>
    <link rel="stylesheet" href="{{ '/assets/research/site.css' | relative_url }}">
    <script src="{{ '/assets/research/site.js' | relative_url }}" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    {% include research/header.liquid %}
    <main id="main" class="container" tabindex="-1">{{ content }}</main>
    {% include research/footer.liquid %}
  </body>
</html>
